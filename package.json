{
  "name": "iqvoc_autoclassify",
  "version": "1.12.0",
  "description": "iQvoc AutoClassify extension.",
  "main": "app/javascript/manifest.js",
  "files": [
    "app/assets/**/*",
    "app/javascript/**/*"
  ],
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innoq/iqvoc_autoclassify.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/innoq/iqvoc_autoclassify/issues"
  },
  "homepage": "https://github.com/innoq/iqvoc_autoclassify#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.108.1"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "iqvoc": "github:innoq/iqvoc",
    "iqvoc_compound_forms": "github:innoq/iqvoc_compound_forms",
    "iqvoc_skosxl": "github:innoq/iqvoc_skosxl"
  }
}
