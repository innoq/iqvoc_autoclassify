<li>
  <span class="auto-classify-result">
    <%= link_to concept_path(result), class: "result-item result-item#{result.origin}" do %>
      <%= result.to_s %>
    <% end %>

    <%= link_to(freeclassify_url(concepts: @selected - [result.origin], query: params[:query]), title: t('txt.views.free_classification.remove_result_item'),  class: 'btn btn-link p-0', data: { toggle: 'tooltip' }) do %>
      <i class="fa fa-times" aria-hidden="true"></i>
    <% end %>

    <button type="button" class="btn-clipboard btn btn-link" data-toggle="tooltip" data-placement="top" title="<%= t('txt.views.free_classification.copy_to_clipboard') %>" data-clipboard-target=".result-item<%= result.origin %>">
      <i class="fa fa-clone" aria-hidden="true"></i>
    </button>
  </span>
</li>