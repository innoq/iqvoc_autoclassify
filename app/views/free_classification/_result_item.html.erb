<li>
  <span class="auto-classify-result">
    <span class="result-item">
      <%= result.pref_label(@free_classification_params[:language]).value %>
    </span>

    <%= link_to(freeclassify_url(@free_classification_params.merge(concepts: @selected - [result.origin])), title: t('txt.views.free_classification.remove_result_item'),  class: 'btn btn-link p-0', data: { bs_toggle: 'tooltip' }) do %>
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    <% end %>

    <%= link_to(concept_path(result), title: t('txt.views.free_classification.show_details'), data: { bs_toggle: 'tooltip' }, class: 'btn btn-link p-0', target: '_blank') do %>
      <i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i>
    <% end %>
  </span>
</li>
