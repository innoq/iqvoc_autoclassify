<% if @results.any? %>
  <%= link_to(freeclassify_url(query: params[:query]), title: t('txt.views.free_classification.remove_all_result_items'), class: 'btn btn-link p-0', data: { bs_toggle: 'tooltip' }) do %>
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  <% end %>

  <button type="button" class="btn-clipboard-multiple btn btn-link p-0" data-bs-toggle="tooltip" title="<%= t('txt.views.free_classification.copy_all_to_clipboard') %>" data-clipboard-targets=".auto-classify-result .result-item" data-clipboard-targets-join-separator=", ">
    <i class="fa-solid fa-clone" aria-hidden="true"></i>
  </button>
<% end %>