<% content_for :scripts do %>
  <%= javascript_include_tag "clipboard.min.js" %>

  <%# FIXME: remove inline js and move to generic assets %>
  <script type="text/javascript">
    jQuery(function($) {
      "use strict";

      new ClipboardJS('.btn-clipboard');
      new ClipboardJS('.btn-clipboard-multiple', {
        text: function (trigger) {
          var targetSelector = $(trigger).data('clipboard-targets');
          var joinSeparator = $(trigger).data('clipboard-targets-join-separator');
          var targets = $(targetSelector);

          return targets.toArray().map(function(element) {
            return element.innerText.trim()
          }).join(joinSeparator);
        }
      });
    });
  </script>
<% end %>

<% if @results.any? %>
  <%= link_to(freeclassify_url(query: params[:query]), title: t('txt.views.free_classification.remove_all_result_items'), class: 'btn btn-link p-0', data: { toggle: 'tooltip' }) do %>
    <i class="fa fa-times" aria-hidden="true"></i>
  <% end %>

  <button type="button" class="btn-clipboard-multiple btn btn-link p-0" data-toggle="tooltip" title="<%= t('txt.views.free_classification.copy_all_to_clipboard') %>" data-clipboard-targets=".auto-classify-result .result-item" data-clipboard-targets-join-separator=", ">
    <i class="fa fa-clone" aria-hidden="true"></i>
  </button>
<% end %>