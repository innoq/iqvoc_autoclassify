<% if result.owner %>
  <% if result.type == 'Labeling::UMT::UsedForLabel' %>
    <li class="search-result">
      <% concepts = result.target.concepts_for_labeling_class(Labeling::UMT::UsedForLabel) %>
      <% link_value = "#{result.target.value} &rarr; #{concepts.join(" + ")}".html_safe %>
      <% highlighed_link_value = highlight(link_value, params[:query], highlighter: '<strong>\1</strong>') %>
      <%= link_to(highlighed_link_value, freeclassify_url(@free_classification_params.merge(concepts: @selected + concepts.map(&:origin))), class: (concepts.map(&:origin).all? { |c| @selected.include? c }) ? 'selected' : '') %>
    </li>
  <% else %>
    <li class="search-result">
      <% link_value = (result.target == result.owner.pref_label ? result.owner.pref_label.value : "#{result.target.value} &rarr; #{result.owner.pref_label.value}".html_safe) %>
      <% highlighed_link_value = highlight(link_value, params[:query], highlighter: '<strong>\1</strong>') %>
      <%= link_to(highlighed_link_value, freeclassify_url(@free_classification_params.merge(concepts: @selected + [result.owner.origin])), class: (@selected.include? result.owner.origin) ? 'selected' : '') %>
    </li>
  <% end %>
<% end %>
