<% if owner = result.owner %>
  <li class="search-result">
    <% link_value = (result.target.value == owner.to_s ? owner.to_s : "#{result.target.value} &rarr; #{owner.to_s}".html_safe) %>
    <% highlighed_link_value = highlight(link_value, params[:query], highlighter: '<strong>\1</strong>') %>
    <%= link_to(highlighed_link_value, freeclassify_url(concepts: @selected + [owner.origin], query: params[:query]), class: (@selected.include? owner.origin) ? 'selected' : '') %>
  </li>
<% end %>
