<% if params[:query] %>
  <ul class="suggestion-results border mt-5">
    <% if @suggestions.any? %>
      <% @suggestions.each do |s| %>
        <%= render 'suggestion_item', result: s %>
      <% end %>
    <% else %>
      <li class="p-2">
        <%= t('txt.views.search_results.no_results_found') %>
      </li>
    <% end %>
  </ul>
<% end %>