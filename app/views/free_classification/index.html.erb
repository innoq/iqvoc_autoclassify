<%= page_header :title => 'Freie Verschlagwortung' %>

<div class="autoclassify">
  <div class="tag-wizard-body row justify-content-between">
    <div class="col-left col-md-6 border-right">

      <%= form_tag freeclassify_path(:query => nil), method: :get do %>
        <div>
          <div class="form-control-with-icon-end">
            <%= label_tag 'search', t('txt.views.free_classification.seatch_input_label') %>

            <div class="input-group">
              <%= search_field_tag 'query', params[:query], id: 'search', class: 'form-control',
                                   autofocus: true,
                                   autocomplete: 'off',
                                   placeholder: t('txt.views.free_classification.query_placeholder'),
                                   'aria-describedby': 'queryHelpBlock' %>
              <div class="input-group-append">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                  <i class="fa fa-cog" aria-hidden="true"></i>
                </button>
                <div class="dropdown-menu p-2">
                  <b><%= t('txt.views.free_classification.settings') %></b>
                  <div role="separator" class="dropdown-divider"></div>
                  <div class="dropdown-item form-check">
                    <%= check_box_tag :include_alt_labels, true, (!params[:query] || params[:include_alt_labels].present?), class: 'form-check-input' %>
                    <%= label_tag :include_alt_labels, t('txt.views.free_classification.include_alt_labels'), class: 'form-check-label' %>
                  </div>

                  <% if can? :use, :administration %>
                    <div role="separator" class="dropdown-divider"></div>
                    <b><%= t('txt.views.free_classification.admin_settings') %></b>
                    <div class="dropdown-item form-check">
                      <%= check_box_tag :include_used_for_labels, true, (params[:include_used_for_labels] == "true") , class: 'form-check-input' %>
                      <%= label_tag :include_used_for_labels, t('txt.views.free_classification.include_used_for_labels'), class: 'form-check-label' %>
                    </div>
                    <div class="dropdown-item form-check">
                      <%= check_box_tag :include_translations, true, params[:include_translations] == "true", class: 'form-check-input' %>
                      <%= label_tag :include_translations, t('txt.views.free_classification.include_translations'), class: 'form-check-label' %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
            <small id="queryHelpBlock">
              <%= t('txt.views.free_classification.query_help_block') %>
            </small>
          </div>
          <%= submit_tag t('txt.views.navigation.search'), class: 'btn btn-primary' %>

          <% @selected.each do |s| %>
            <%= hidden_field_tag 'concepts[]', s %>
          <% end %>
        </div>
      <% end %>

      <%= render partial: 'suggestion_list' %>
    </div>

    <div class="col-right col-md-6">
      <h2 class="mb-4">
        <%= t('txt.views.free_classification.results_title') %>
        <%= render partial: 'controls' %>
      </h2>

      <%= render partial: 'result_list' %>
    </div>

  </div>
</div>

<div class="border p-2 text-center fixed-bottom">
  <%= raw t('txt.common.contact_message', email: mail_to(t('txt.common.contact_email'), t('txt.common.contact_email'), subject: 'Feedback Verschlagwortungsassistent')) %>
</div>