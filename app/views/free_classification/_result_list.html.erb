<% if @results.any? %>
  <ul class="auto-classify-result-list">
    <% @results.sort_by { |r| @selected.index(r.origin)}.each do |result| %>
      <%= render partial: 'result_item', locals: { result: result } %>
    <% end %>
  </ul>
<% else %>
  <div class="alert alert-info" role="alert">
    <%= t('txt.views.free_classification.no_results') %>
  </div>
<% end %>
