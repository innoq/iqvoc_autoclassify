<h1><%= @document.title || @document.content_hash %></h1>

<%= link_to(@document.title || @document.uri, @document.uri) if @document.uri %>

<% if defined?(display_comment_form) && display_comment_form %>
<div class="new_comment">
  <h3><%= t("txt.views.document.comment") %></h1>
  <%= form_for([@document, @document.comments.build]) do |f| %>
    <label>
      <%= f.text_area :body %>
    </label>

    <div class="actions">
      <%= f.submit t("txt.common.save") %>
    </div>
  <% end %>
<% end %>
</div>

<h2><%= Concept::Base.model_name.human(:count => 2) %></h2>
<ol>
  <%- @document.classifications.each { |classification| -%>
    <li>
      <%= link_to classification.to_s, classification.concept_uri %>
      [<%= classification.weighting %>]
    </li>
  <%- } -%>
</ol>
<p><%= t("txt.views.document.last_update") %>: <%= @document.updated_at %></p>

<h2><%= t("txt.models.document.full_text") %></h2>
<blockquote style="white-space: pre-wrap;"><%= @document.content.strip %></blockquote>
