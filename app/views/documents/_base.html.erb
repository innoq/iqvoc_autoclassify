<%- if @document.uri -%>
<h1><%= link_to(@document.title || @document.content_hash, @document.uri) %></h1>
<%- else -%>
<h1><%= @document.title || @document.content_hash %></h1>
<%- end -%>

<% if defined?(display_comment_form) && display_comment_form %>
<div class="new_comment">
  <h3><%= t("txt.views.document.comment") %></h3>
  <%= form_for([@document, @document.comments.build]) do |f| %>
    <label>
      <%= f.text_area :body %>
    </label>

    <div class="actions">
      <%= f.submit t("txt.common.save") %>
    </div>
  <% end %>
<% end %>
</div>

<h2><%= Concept::Base.model_name.human(:count => 2) %></h2>
<ol>
  <%- @classifications.each { |classification| -%>
    <li>
      <%= link_to classification.to_s, classification.concept_uri %>
      <span class="weighting">[<%= "%4.2f" % classification.weighting %>]</span>
    </li>
  <%- } -%>
</ol>
<div class="autoclassify"><%= paginate @classifications %></div> <!-- XXX: divitis!? -->
<p><%= Document.human_attribute_name(:updated_at) %>: <%= @document.updated_at %></p>

<h2><%= t("txt.models.document.full_text") %></h2>
<blockquote style="white-space: pre-wrap;"><%= @document.content.strip %></blockquote>
