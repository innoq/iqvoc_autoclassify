<%= page_header title: t("txt.controllers.documents.new.title") %>
<%= render "sidebar" %>

<%= simple_format t('txt.controllers.documents.new.description') %>

<ul class="nav nav-tabs mt-5" id="myTab" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link active" id="text-tab" data-bs-toggle="tab" href="#text" role="tab" aria-controls="text" aria-selected="true">
      <%= Document::Base.human_attribute_name :content %>
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="url-tab" data-bs-toggle="tab" href="#url" role="tab" aria-controls="uri" aria-selected="false">
      <%= Document::Base.human_attribute_name :url %>
    </a>
  </li>

  <% if ENV['AUTOCLASSIFY_SERVICE_URI'].present? and can?(:use, :administration) %>
    <li class="nav-item" role="presentation">
      <a class="nav-link" id="text2-tab" data-bs-toggle="tab" href="#text2" role="tab" aria-controls="text2" aria-selected="false">
        AutoClassify2 <%= Document::Base.human_attribute_name :content %>
      </a>
    </li>
  <% end %>
</ul>

<div class="tab-content" id="myTabContent">
  <div class="tab-pane fade show active" id="text" role="tabpanel" aria-labelledby="text-tab">
    <%= render 'plain_form', url: plain_documents_path %>
  </div>

  <div class="tab-pane fade" id="url" role="tabpanel" aria-labelledby="url-tab">
    <%= render 'extracted_form', url: extracted_documents_path %>
  </div>

  <% if ENV['AUTOCLASSIFY_SERVICE_URI'].present? and can?(:use, :administration) %>
    <div class="tab-pane fade" id="text2" role="tabpanel" aria-labelledby="text2-tab">
      <%= render 'plain_form', url: plain2_documents_path, show_options: false, id_suffix: '_2' %>
    </div>
  <% end %>
</div>

