<li>
  <span class="auto-classify-result">
    <span class="result-item">
      <%= classification.to_s %>
    </span>

    <% if current_user %>
      [<%= classification.weighting %>]
    <% end %>

    <%= link_to(concept_path(classification.concept), title: t('txt.views.free_classification.show_details'), data: { bs_toggle: 'tooltip' }, class: 'btn btn-link p-0', target: '_blank') do %>
      <i class="fa-solid fa-magnifying-glass-plus" aria-hidden="true"></i>
    <% end %>
  </span>
</li>
