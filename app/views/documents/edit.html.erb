<%= page_header title: t("txt.controllers.documents.new.title") %>
<%= render "sidebar" %>

<%= simple_format t('txt.controllers.documents.new.description') %>

<ul class="nav nav-tabs mt-5" id="myTab" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link active" id="text-tab" data-toggle="tab" href="#text" role="tab" aria-controls="text" aria-selected="true">
      <%= Document::Base.human_attribute_name :content %>
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="url-tab" data-toggle="tab" href="#url" role="tab" aria-controls="uri" aria-selected="false">
      <%= Document::Base.human_attribute_name :url %>
    </a>
  </li>
</ul>

<div class="tab-content" id="myTabContent">
  <div class="tab-pane fade show active" id="text" role="tabpanel" aria-labelledby="home-tab">
    <%= bootstrap_form_for @document, as: :document, url: document_url(@document), html: { class: 'document-form' } do |f| %>
      <fieldset>
        <%= f.select :language, Iqvoc::Concept.pref_labeling_languages.map { |lang| [t(lang, scope: 'languages'), lang] },
                     include_blank: t('txt.controllers.documents.new.select_language_prompt') %>

        <%= f.text_field :title %>

        <%= f.text_area :content, rows: 10, label: t('txt.controllers.documents.new.enter_text'), autofocus: 'true' %>

        <%= f.button t("txt.controllers.documents.new.classify_text"), class: 'btn btn-primary', data: {disable_with: loading_indicator(t("txt.controllers.documents.new.classify_process"))} %>
        <%= submit_tag(t("txt.controllers.documents.new.reset_text"), name: 'reset', id: 'reset_button', type: 'reset', class: 'btn btn-outline-secondary') %>
      </fieldset>
    <% end %>
  </div>

  <div class="tab-pane fade" id="url" role="tabpanel" aria-labelledby="url-tab">
    <%= bootstrap_form_for @document, url: document_url(@document), html: { class: 'document-form' } do |f| %>
      <fieldset>

        <%= f.select :language, Iqvoc::Concept.pref_labeling_languages.map { |lang| [t(lang, scope: 'languages'), lang] },
                     include_blank: t('txt.controllers.documents.new.select_language_prompt') %>

        <%= f.form_group nil do %>
          <%= f.text_field :uri, :class => 'form-control', placeholder: 'https://', label: t('txt.controllers.documents.new.enter_uri') %>
        <% end %>

        <%= f.button t("txt.controllers.documents.new.classify_url") , class: 'btn btn-primary', data: {disable_with: loading_indicator(t("txt.controllers.documents.new.classify_process"))} %>
      </fieldset>
    <% end %>
  </div>
</div>

