<%= page_header title: t("txt.controllers.documents.new.title") %>
<%= render "sidebar" %>

<%= simple_format t('txt.controllers.documents.new.description') %>

<ul class="nav nav-tabs mt-5" id="myTab" role="tablist">
  <li class="nav-item" role="presentation">
    <a class="nav-link active" id="text-tab" data-toggle="tab" href="#text" role="tab" aria-controls="text" aria-selected="true">
      <%= Document::Base.human_attribute_name :content %>
    </a>
  </li>
  <li class="nav-item" role="presentation">
    <a class="nav-link" id="url-tab" data-toggle="tab" href="#url" role="tab" aria-controls="uri" aria-selected="false">
      <%= Document::Base.human_attribute_name :url %>
    </a>
  </li>
</ul>

<div class="tab-content" id="myTabContent">
  <div class="tab-pane fade show active" id="text" role="tabpanel" aria-labelledby="home-tab">
    <%= render 'plain_form', url: document_url(@document) %>
  </div>

  <div class="tab-pane fade" id="url" role="tabpanel" aria-labelledby="url-tab">
    <%= render 'extracted_form', url: document_url(@document) %>
  </div>
</div>

