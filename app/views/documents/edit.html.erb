<%= form_for(@document) do |f| %>
  <div class="field">
    <%= content_tag :label do %>
      <%= check_box_tag :reclassify %>
      <%= t("txt.models.views.document.reclassify") %>
    <% end %>
  </div>
  <div class="actions">
    <%= f.submit t("txt.common.save") %>
  </div>
<% end %>

<%= render "base" %>
