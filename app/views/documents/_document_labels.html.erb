<% if document.language.present? %>
  <span class="badge bg-secondary"><%= t(document.language, scope: 'languages') %></span>
<% end %>

<% if document.class == Document::Plain %>
  <span class="badge bg-success">AutoClassify1</span>
<% elsif document.class == Document::Autoclassify2::Plain %>
  <span class="badge bg-warning">AutoClassify2</span>
<% elsif document.class == Document::Compare::Plain %>
  <span class="badge bg-danger">Vergleich</span>
<% end %>
