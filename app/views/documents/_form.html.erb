<%= bootstrap_form_for @document, :url => extracted_documents_path, :html => { :class => 'document-form' } do |f| %>
  <fieldset>
    <legend><%= Document::Base.human_attribute_name :url %> (HTML/PDF)</legend>
    <%= f.form_group nil do %>
      <%= text_field_tag :uri, nil, :class => 'form-control' %>
    <% end %>

    <hr/>
    <div class="well">
      <%= f.submit (current_user ? t("txt.common.save") : t("txt.common.edit")), :class => "btn btn-primary" %>
    </div>
  </fieldset>
<% end %>

<%= bootstrap_form_for @document, :as => :document, :url => plain_documents_path, :html => { :class => 'document-form' } do |f| %>
  <fieldset>
    <legend><%= Document::Base.human_attribute_name :content %></legend>

    <%= f.text_field :title  %>
    <%= f.text_area :content %>

    <div class="well">
      <%= f.submit (current_user ? t("txt.common.save") : t("txt.common.edit")), :class => "btn btn-primary" %>
    </div>
  </fieldset>
<% end %>
