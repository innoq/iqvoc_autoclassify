<%= simple_form_for @document, :url => extracted_documents_path, :html => { :class => 'document-form' } do |f| %>
  <fieldset>
    <legend><%= Document::Base.human_attribute_name :url %></legend>
    <%= input_block do %>
      <%= text_field_tag :uri, nil, :class => "span6" %>
    <% end %>

    <div class="form-actions">
      <%= f.submit t("txt.common.save"), :class => "btn btn-primary", :id => nil %>
    </div>
  </fieldset>
<% end %>

<%= simple_form_for @document, :as => :document, :url => plain_documents_path, :html => { :class => 'document-form' } do |f| %>
  <fieldset>
    <legend><%= Document::Base.human_attribute_name :content %></legend>

    <%= f.input :title, :input_html => { :class => "span6" }  %>
    <%= f.input :content, :input_html => { :class => "span6" } %>

    <div class="form-actions">
      <%= f.submit t("txt.common.save"), :class => "btn btn-primary" %>
    </div>
  </fieldset>
<% end %>
