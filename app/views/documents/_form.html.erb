<%= form_for(@document) do |f| %>
  <%- if @document.errors.any? -%>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@document.errors.count, "error") %>
        prohibited this document from being saved: <!-- TODO: i18n -->
      </h2>
      <ul>
      <%- @document.errors.full_messages.each do |msg| -%>
        <li><%= msg %></li>
      <%- end -%>
      </ul>
    </div>
  <%- end -%>

  <fieldset>
    <legend><%= t("txt.models.document.url") %></legend>
    <label>
      <%= text_field_tag :url %>
    </label>

    <div class="actions">
      <%= f.submit t("txt.common.save"), :id => nil %>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("txt.models.document.full_text") %></legend>
    <label>
      <%= Document.human_attribute_name(:title) %>
      <%= f.text_field :title %>
    </label>
    <label>
      <%= f.text_area :content %>
    </label>

    <div class="actions">
      <%= f.submit t("txt.common.save") %>
    </div>
  </fieldset>
<% end %>
