<%= form_for(@document) do |f| %> <!-- TODO: i18n -->
  <%- if @document.errors.any? -%>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@document.errors.count, "error") %>
        prohibited this document from being saved:
      </h2>
      <ul>
      <%- @document.errors.full_messages.each do |msg| -%>
        <li><%= msg %></li>
      <%- end -%>
      </ul>
    </div>
  <%- end -%>

  <fieldset>
    <legend>URL</legend>
    <%= content_tag :label do %>
      <%= text_field_tag :url %>
    <% end %>
  </fieldset>

  <fieldset>
    <legend>Text</legend>
    <%= content_tag :label do %>
      <%= f.text_area :content %>
    <% end %>
  </fieldset>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
