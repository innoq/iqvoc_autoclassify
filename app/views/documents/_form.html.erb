<div class="row justify-content-between">
  <div class="col-md-5 mb-5">
    <%= bootstrap_form_for @document, :as => :document, :url => plain_documents_path, :html => { :class => 'document-form' } do |f| %>
      <fieldset>
        <legend><%= Document::Base.human_attribute_name :content %></legend>

        <%= f.text_area :content, rows: 5, hide_label: true %>

        <%= f.button t("txt.controllers.documents.new.classify_text"), class: 'btn btn-primary', data: {disable_with: loading_indicator(t("txt.controllers.documents.new.classify_process"))} %>
      </fieldset>
    <% end %>
  </div>

  <div class="col-divider d-none d-md-block align-items-center">
	  <span>ODER</span>
  </div>

  <div class="col-md-5">
    <%= bootstrap_form_for @document, :url => extracted_documents_path, :html => { :class => 'document-form' } do |f| %>
      <fieldset>
        <legend><%= t("txt.controllers.documents.new.classify_url_desc") %></legend>
        <%= f.form_group nil do %>
          <%= f.text_field :uri, :class => 'form-control', placeholder: 'http://', hide_label: true %>
        <% end %>

        <%= f.button t("txt.controllers.documents.new.classify_url") , class: 'btn btn-primary', data: {disable_with: loading_indicator(t("txt.controllers.documents.new.classify_process"))} %>
      </fieldset>
    <% end %>
  </div>

</div>
