<%= bootstrap_form_for @document, as: :document, url: url, html: { class: 'document-form' } do |f| %>
  <fieldset>
    <%= f.collection_radio_buttons :language,
                                   Iqvoc::Concept.pref_labeling_languages.map { |lang| [lang, t(lang, scope: 'languages')] } +
                                   [
                                     ["", t('txt.controllers.documents.new.select_language_prompt')]
                                   ],
                                   :first,
                                   :last,
                                   help: t('txt.controllers.documents.new.language_selection_help') do |option| %>
      <div class="form-check">
        <%= option.radio_button(class: 'form-check-input') + option.label(class: 'form-check-label') %>
      </div>
    <% end %>

    <% if can?(:use, :administration) %>
      <% Document::Base::BOOLEAN_OPTIONS.each do |bool_attr| %>
        <%= f.check_box bool_attr %>
      <% end %>
      <hr>
    <% end %>

    <%= f.text_field :title %>

    <%= f.text_area :content, rows: 10, label: t('txt.controllers.documents.new.enter_text'), autofocus: 'true' %>

    <%= f.button t("txt.controllers.documents.new.classify_text"), class: 'btn btn-primary', data: {disable_with: loading_indicator(t("txt.controllers.documents.new.classify_process"))} %>
    <%= submit_tag(t("txt.controllers.documents.new.reset_text"), name: 'reset', id: 'reset_button', type: 'reset', class: 'btn btn-outline-secondary') %>
  </fieldset>
<% end %>
