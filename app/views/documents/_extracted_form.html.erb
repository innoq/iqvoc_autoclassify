<%= bootstrap_form_for @document, url: url, html: { class: 'document-form' } do |f| %>
  <fieldset>
    <legend class="form-label"><%= Document::Base.human_attribute_name :language %></legend>
    <%= f.collection_radio_buttons :language,
                                   Iqvoc::Concept.pref_labeling_languages.map { |lang| [lang, t(lang, scope: 'languages')] } +
                                   [
                                     ["", t('txt.controllers.documents.new.select_language_prompt')]
                                   ],
                                   :first,
                                   :last,
                                   skip_label: true,
                                   help: t('txt.controllers.documents.new.language_selection_help') do |option| %>
      <div class="form-check">
        <%= option.radio_button(class: 'form-check-input') + option.label(class: 'form-check-label') %>
      </div>
    <% end %>

    <% if can?(:use, :administration) %>
      <% Document::Base::BOOLEAN_OPTIONS.each do |bool_attr| %>
        <%= f.check_box bool_attr %>
      <% end %>
      <hr>
    <% end %>

    <%= f.form_group nil do %>
      <%= f.text_field :uri, :class => 'form-control', placeholder: 'https://', label: t('txt.controllers.documents.new.enter_uri') %>
    <% end %>

    <%= f.button t("txt.controllers.documents.new.classify_url"), class: 'btn btn-primary', data: { disable_with: loading_indicator(t("txt.controllers.documents.new.classify_process")) } %>
  </fieldset>
<% end %>
