<%= page_header :title => Document::Base.model_name.human(:count => 2) %>
<%= render "sidebar" %>

<table class="table documents-table">
  <thead>
    <tr>
      <th><%= Document::Base.human_attribute_name(:updated_at) %></th>
      <th><%= Document::Base.human_attribute_name(:title) %></th>
      <th><%= Concept::Base.model_name.human(:count => 2) %></th>
    </tr>
  </thead>
  <tbody>
    <% @documents.each do |doc| %>
      <tr class="documents-table-item">
        <td class="text-nowrap"><%= l doc.updated_at, format: :short %></td>
        <td>
          <%= link_to doc.title, document_path(:id => doc),
            class: 'documents-table-item-link' %>
        </td>
        <td class="documents-table-item-classifications">
          <%= doc.classifications.length %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @documents %>
