<%= page_header :title => Document::Base.model_name.human(:count => 2) %>
<%= render "sidebar" %>

<div class="row">
  <div class="col-sm-4 float-end">
    <%= image_tag 'thesaurus_fox.png', class: "img-fluid thesaurus-fox" %>
  </div>
</div>

<table class="table documents-table">
  <thead>
    <tr>
      <th><%= Document::Base.human_attribute_name(:title) %></th>
      <th><%= ::Concept::Base.model_name.human(count: 2) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @documents.each do |doc| %>
      <tr class="documents-table-item">
        <td>
          <%= link_to doc.title || t('txt.views.document.no_title'), document_path(:id => doc.id), class: 'documents-table-item-link' %>

          <%= render 'document_labels', document: doc %>

          <%= link_to "<i class='fa-solid fa-share'></i>".html_safe, doc.uri, target: :_blank, title: t('txt.views.document.visit_website') if doc.uri %>
          <div>
            <%= truncate(doc.content, length: 80) %>
          </div>
          <div>
            <%= doc.classifications.first(5).map {|c| "#{link_to c.title, concept_path(c.concept_origin), target: :_blank, class: 'badge bg-primary'}"}.join(" ").html_safe %>
          </div>
        </td>
        <td class="documents-table-item-classifications">
          <%= doc.classifications.length %>
        </td>
        <td>
          <% if can? :use, :administration %>
            <%= link_to t("txt.common.delete"), document_path(doc), method: :delete, data: { confirm: t("txt.controllers.documents.index.delete_confirm") }, class: 'btn btn-danger btn-sm' %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @documents %>
