<%= render "base" %>

<h1><%= Comment.model_name.human(:count => 2) %></h1>

<%= form_for([@document, @document.comments.build]) do |f| %>
  <label>
    <%= f.text_area :body %>
  </label>

  <div class="actions">
    <%= f.submit t("txt.common.save") %>
  </div>
<% end %>

<%= link_to t("txt.views.document.index"), documents_path %>
