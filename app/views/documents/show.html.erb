<h1><%= @document.content_hash %></h1> <!-- FIXME: can there ever be a concise, human-friendly string representation for individual documents? -->

<h2>Concepts</h2> <!-- TODO: i18n -->
<ol>
  <%- @document.concepts.each { |concept, weighting| -%>
    <li><%= concept.to_s %> (<%= weighting %>)</li>
  <%- } -%>
</ol>

<h2>Full Text</h2> <!-- TODO: i18n -->
<pre><%= @document.content %></pre>
