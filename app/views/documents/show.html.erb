<%= page_header title: t('txt.views.document.show.title') %>

<%= render 'toolbar' if current_user %>

<% if current_user %>
  <%= stylesheet_link_tag "iqvoc_autoclassify/jquery.mintip.css" %>
  <%= content_for :scripts do %>
      <%= javascript_include_tag "iqvoc_autoclassify/jquery.mintip.js" %>
  <% end %>
<% end %>

<% if @document.uri %>
  <%= simple_format(t('txt.views.document.show.description_url_analysis', url: link_to(t('txt.views.document.show.url'), @document.uri))) %>
<% else %>
  <%= t('txt.views.document.show.description_text_analysis') %>
<% end %>

<div class="row pt-4">
  <div class="col-md-8">

    <% if current_user %>
    <ul class="nav nav-tabs" id="myTab" role="tablist">
      <li class="nav-item" role="presentation">
        <a class="nav-link active" id="text-tab" data-toggle="tab" href="#text" role="tab" aria-controls="text" aria-selected="true">
          <%= t("txt.views.document.show.text") %>
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link" id="url-tab" data-toggle="tab" href="#extended" role="tab" aria-controls="extended" aria-selected="false">
          <%= t("txt.views.document.show.detailed_analysis") %>
        </a>
      </li>
    </ul>
    <% end %>

    <div id="auto-classify-analysed-text">
      <% if current_user %>
        <div class="tab-content" id="myTabContent">
          <div class="tab-pane fade show active" id="text" role="tabpanel" aria-labelledby="home-tab">
            <%= @document.content %>
          </div>

          <div class="tab-pane fade" id="extended" role="tabpanel" aria-labelledby="url-tab">
            <pre class="trace">
            <%= raw augmented_fulltext(@document) %>
            </pre>
          </div>
        </div>
      <% else %>
        <%= @document.content %>
      <% end %>
    </div>
  </div>

  <div class="col-md-4" id="auto-classify-results">
    <h2><%= t('txt.views.document.show.results') %></h2>

    <ul class="auto-classify-result-list">
    <% if @document.persisted? && @classifications %>
      <% @classifications.each do |classification| %>
        <li>
          <%= link_to concept_path(classification.concept), class: 'auto-classify-result' do %>
            <%= classification.to_s %>
            <% if current_user %>
              [<%= classification.weighting %>]
            <% end %>
          <% end %>
        </li>
      <% end %>
    <% else %>
      <% (Array.new(@document.classifications).sort_by { |c| -1 * c.weighting }).each do |classification| %>
      <li>
        <%= link_to classification.to_s, concept_path(classification.concept), class: 'auto-classify-result' %>
      </li>
      <% end %>
    <% end %>
    </ul>
  </div>
</div>
