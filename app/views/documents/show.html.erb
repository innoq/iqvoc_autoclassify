<%= page_header title: t('txt.views.document.show.title') %>

<div class="row">
  <div class="col-md-8">
    <%= render 'toolbar' if current_user and @document.persisted? %>

    <% if @document.uri %>
      <%= t('txt.views.document.show.description_url_analysis') %>
      <%= link_to(@document.uri, @document.uri, target: '_blank') %>
    <% end %>

    <% if @document.language.present? %>
      <div class="mt-3">
        <span class="badge badge-secondary"><%= t(@document.language, scope: 'languages') %></span>

        <% if @document.is_a? Document::Autoclassify2::Plain %>
          <span class="badge badge-warning">AutoClassify2</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="col-md-4">
    <div class="list-group">
      <%= render 'sidebar_content' %>
    </div>
  </div>
</div>

<div class="row pt-4">
  <div class="col-md-8">

    <% if current_user and @document.persisted? %>
    <ul class="nav nav-tabs" id="myTab" role="tablist">
      <li class="nav-item" role="presentation">
        <a class="nav-link active" id="text-tab" data-toggle="tab" href="#text" role="tab" aria-controls="text" aria-selected="true">
          <%= t("txt.views.document.show.text") %>
        </a>
      </li>
      <li class="nav-item" role="presentation">
        <a class="nav-link" id="url-tab" data-toggle="tab" href="#extended" role="tab" aria-controls="extended" aria-selected="false">
          <%= t("txt.views.document.show.detailed_analysis") %>
        </a>
      </li>
      <% if @document.api_response_body.present? %>
        <li class="nav-item" role="presentation">
          <a class="nav-link" id="api-tab" data-toggle="tab" href="#api-response" role="tab" aria-controls="api-response" aria-selected="false">
            <%= t("txt.views.document.show.api_response_body") %>
          </a>
        </li>
      <% end %>
    </ul>
    <% end %>

    <div id="auto-classify-analysed-text">
      <% if current_user and @document.persisted? %>
        <div class="tab-content" id="myTabContent">
          <div class="tab-pane fade show active" id="text" role="tabpanel" aria-labelledby="home-tab">
            <%= render 'document', document: @document %>
          </div>

          <div class="tab-pane fade" id="extended" role="tabpanel" aria-labelledby="url-tab">
            <% if @document.classification_trace&.trace %>
              <pre class="trace">
              <%= raw augmented_fulltext(@document) %>
              </pre>
            <% else %>
              <%= t('txt.views.document.show.no_trace') %>
            <% end %>
          </div>
          <% if @document.api_response_body.present? %>
            <div class="tab-pane fade" id="api-response" role="tabpanel" aria-labelledby="api-tab">
            <pre class="json">
              <%= JSON.pretty_generate(@document.api_response_body) %>
            </pre>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render 'document', document: @document %>
      <% end %>
    </div>
  </div>

  <div class="col-md-4" id="auto-classify-results">
    <% if @document.persisted? && @classifications %>
      <%# documents_controller#show %>
      <% classifications = @classifications %>
    <% else %>
      <%# plain_controller#create %>
      <% classifications = Array.new(@document.classifications).sort_by { |c| -1 * c.weighting } %>
    <% end %>
    <% limit = 15 # FIXME: all a bit hacky %>

    <h2>
      <%= t('txt.views.document.show.results') %>
      <% if classifications.any? %>
        <button type="button" class="btn-clipboard-multiple btn btn-link p-0" data-toggle="tooltip" title="<%= t('txt.views.free_classification.copy_all_to_clipboard') %>" data-clipboard-targets=".auto-classify-result .result-item" data-clipboard-targets-join-separator=", ">
          <i class="fa fa-clone" aria-hidden="true"></i>
        </button>
      <% end %>
    </h2>

    <% if classifications.any? %>
      <ul class="auto-classify-result-list">
        <% classifications.take(limit).each do |classification| %>
          <%= render partial: 'result_item', locals: { classification: classification } %>
        <% end %>
      </ul>
    <% else %>
      <div class="alert alert-info" role="alert">
        <%= t('txt.views.document.show.no_results') %>
      </div>
    <% end %>

    <% if classifications.size > limit %>
      <a href="#show-all" data-toggle="collapse"><%= "#{t('txt.views.document.show.show_all')} (#{classifications.size-limit})" %></a>
      <div id="show-all" class="collapse">
        <ul class="auto-classify-result-list">
        <% classifications[limit,classifications.size].each do |classification| %>
          <%= render partial: 'result_item', locals: { classification: classification } %>
        <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
