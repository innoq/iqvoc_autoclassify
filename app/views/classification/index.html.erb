<div class="autoclassify">
  <div class="frontpage-title text-center">
    <h1 class="display-4">
      <%= t('txt.views.classification.tag_wizard_title').html_safe %>
    </h1>

    <p class="lead">
      <%= t('txt.views.classification.tag_wizard_desc') %>
    </p>
  </div>

  <div class="tag-wizard-body row justify-content-between mt-5">
    <div class="col-left col-md-6 mt-5">
      <h2><%= t('txt.views.classification.auto_classify_title') %></h2>

      <p><%= t('txt.views.classification.auto_classify_desc') %></p>

      <%= link_to t('txt.views.classification.auto_classify_title'), autoclassify_path, class: 'btn btn-primary mt-3' %>
    </div>

    <div class="col-right col-md-6 mt-5">
      <h2><%= t('txt.views.classification.free_classify_title') %></h2>

      <p><%= t('txt.views.classification.free_classify_desc') %></p>

      <%= link_to t('txt.views.classification.free_classify_title'), freeclassify_path, class: 'btn btn-primary mt-3' %>
    </div>

    <div class="col">
      <p><%= t('txt.views.classification.about_services', about_link: link_to("hier", "/de/dienste")).html_safe %></p>
    </div>
  </div>
</div>
